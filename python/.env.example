# Textbelt SMS
TEXTBELT_API_KEY=
CAREGIVER_PHONE_NUMBER=+15555555555
# CAREGIVER_PHONE_NUMBERS=+15555555555,+15555555556

# Runtime
# Keep this at 1 for rehearsals; set it to 0 only when ready to send real alerts.
ALERT_DRY_RUN=1
LOG_LEVEL=INFO
# bridge   = detections arrive via Bridge report_detection() (nothing runs here)
# stream   = TinyAudioNet runs HERE on audio streamed from the Mac (AUD: lines)   <- demo
# model    = TinyAudioNet runs here on a microphone attached to the UNO Q
# scripted = replay the demo script
CLASSIFIER=stream
LED_ENABLED=1
# sound_event = Bridge.notify("sound_event", "GLASS"/"ALARM"/...) (deployed sketch)
# rpc         = Bridge.call("show_emergency", event_id)
LED_PROTOCOL=sound_event

# The stream classifier already confirms detections (>= 0.70 confidence, 2 of 3
# windows). Keep the per-event thresholds at or below that so accepted
# detections are not rejected a second time here.
ALERT_THRESHOLD=0.70

# Alert policy
EVENT_COOLDOWN_SECONDS=60
GLOBAL_COOLDOWN_SECONDS=0
HITS_REQUIRED=1
HITS_WINDOW_SECONDS=3
SMS_INCLUDE_CONFIDENCE=0
SMS_PLAIN_TEXT=0

# Optional SMTP e-mail
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
# EMAIL_TO=
