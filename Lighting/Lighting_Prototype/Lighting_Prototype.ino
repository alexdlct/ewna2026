void setup() {
  matrix.begin();

  matrix.setGrayscaleBits(1);
  matrix.draw(allOn);

}

void loop() {
  delay(1000);

  matrix.draw(skull);
  delay(1000);

  matrix.draw(CO);
  delay(1000);

  matrix.draw(shatter_effect);
  delay(1000);

  matrix.draw(SOS);
  delay(1000);

  matrix.draw(human_voice_frequency);
  delay(1000);

  matrix.draw(water_droplet);
  delay(1000);

  matrix.draw(danger_sign);
  delay(1000);

  matrix.draw(lightning_symbol);
  delay(1000);

}