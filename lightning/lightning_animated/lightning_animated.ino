// ============================================================
// ANIMATION FUNCTIONS
// ============================================================

void animateVoice() {
  for (int i = 0; i < 4; i++) {
    matrix.draw(voice1);
    delay(180);

    matrix.draw(voice2);
    delay(180);
  }
}


void animateWater() {
  matrix.draw(water1);
  delay(180);

  matrix.draw(water2);
  delay(180);

  matrix.draw(water3);
  delay(350);
}


void animateDanger() {
  for (int i = 0; i < 4; i++) {
    matrix.draw(danger_sign);
    delay(200);

    matrix.clear();
    delay(120);
  }

  matrix.draw(danger_sign);
  delay(400);
}


void animateLightning() {
  // Fast electrical flashing
  for (int i = 0; i < 4; i++) {
    matrix.draw(lightning_symbol);
    delay(70);

    matrix.clear();
    delay(60);
  }

  matrix.draw(lightning_symbol);
  delay(300);
}


void animateShatter() {
  matrix.draw(shatter1);
  delay(130);

  matrix.draw(shatter2);
  delay(130);

  matrix.draw(shatter3);
  delay(500);
}


void animateSkull() {
  // Skull flashes ominously
  for (int i = 0; i < 3; i++) {
    matrix.draw(skull);
    delay(300);

    matrix.clear();
    delay(120);
  }

  matrix.draw(skull);
  delay(500);
}


void animateCO() {
  // CO warning blink
  for (int i = 0; i < 4; i++) {
    matrix.draw(CO);
    delay(250);

    matrix.clear();
    delay(150);
  }
}


void animateSOS() {
  // SOS emergency flashing
  for (int i = 0; i < 6; i++) {
    matrix.draw(SOS);
    delay(180);

    matrix.clear();
    delay(120);
  }

  matrix.draw(SOS);
  delay(500);
}


// ============================================================
// SETUP
// ============================================================

void setup() {

  matrix.begin();

  matrix.setGrayscaleBits(1);

  matrix.clear();
}


// ============================================================
// LOOP
// ============================================================

void loop() {

  // 1. Human voice
  animateVoice();

  matrix.clear();
  delay(700);


  // 2. Water
  animateWater();

  matrix.clear();
  delay(700);


  // 3. General danger
  animateDanger();

  matrix.clear();
  delay(700);


  // 4. Electrical danger
  animateLightning();

  matrix.clear();
  delay(700);


  // 5. Collision / shatter
  animateShatter();

  matrix.clear();
  delay(700);


  // 6. Severe danger
  animateSkull();

  matrix.clear();
  delay(700);


  // 7. Carbon monoxide
  animateCO();

  matrix.clear();
  delay(700);


  // 8. Emergency SOS
  animateSOS();

  matrix.clear();
  delay(1500);
}